{
  "name": "bureauos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-env.mjs generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/prisma-env.mjs migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migration:new": "node scripts/new-migration.mjs",
    "db:generate": "node scripts/prisma-env.mjs generate",
    "db:sync": "node scripts/sync-postgres-schema.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "retention": "tsx scripts/retention.ts",
    "postinstall": "node scripts/prisma-env.mjs generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
