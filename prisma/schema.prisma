// BureauOS — database schema (Phase 1: SQLite, local development).
//
// This is the ACTIVE schema backing the app's API routes via Prisma.
//
// SQLite adaptations from the original Postgres-shaped draft (see
// docs/backend_migration_plan.md for the full delta):
//   - Prisma enums are not supported on SQLite → status/role/tier columns are
//     String and hold the SAME lowercase values the domain types use
//     (e.g. "in_progress", "assisted_review"). Zod validates every value at
//     the API boundary (lib/schemas.ts).
//   - Json columns → String columns holding serialized JSON (answers, plan
//     actions/risk flags). Serializers in lib/server/serializers.ts parse.
//   - User.passwordHash backs the Auth.js credentials provider (scrypt).
//     Sessions are stateless Auth.js JWTs — no session table needed.
//
// Postgres migration: switch provider to "postgresql", reintroduce enums and
// Json types, drop Session/passwordHash in favor of the auth provider.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Scrypt hash backing the Auth.js credentials provider.
  passwordHash String   @default("")
  role         String   @default("customer") // "customer" | "admin"
  // Staff MFA (RFC 6238 TOTP). Required for admin sign-in in production.
  mfaSecret    String   @default("") // base32; set during enrollment
  mfaEnabled   Boolean  @default(false)
  usState      String   @default("")
  phone        String   @default("")
  createdAt    DateTime @default(now())

  notificationPrefs NotificationPreference?
  cases             Case[]
  subscriptions     Subscription[]
  tickets           SupportTicket[]
  reviews           ReviewRequest[]
  files             UploadedFile[]
  acceptances       DisclaimerAcceptance[]
  notifications     NotificationEvent[]
}

model NotificationPreference {
  id                       String  @id @default(cuid())
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                   String  @unique
  emailReminders           Boolean @default(true)
  smsReminders             Boolean @default(false)
  deadlineAlerts           Boolean @default(true)
  caseStatusAlerts         Boolean @default(true)
  missingDocumentReminders Boolean @default(true)
  supportTicketUpdates     Boolean @default(true)
}

model Case {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  navigatorSlug String // content-defined navigator (lib/navigators)
  title         String
  status        String   @default("intake") // CaseStatus values
  priority      String   @default("medium") // Priority values
  serviceTier   String   @default("self_service") // ServiceTierId values
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  intakeCompleted Boolean @default(false)
  intakeStep      Int     @default(0)

  answers    IntakeAnswer[]
  plan       ActionPlan?
  tasks      Task[]
  documents  DocumentRequirement[]
  deadlines  Deadline[]
  letters    GeneratedLetter[]
  timeline   TimelineEvent[]
  files      UploadedFile[]
  adminNotes AdminNote[]
  reviews    ReviewRequest[]
  tickets    SupportTicket[]

  @@index([userId])
}

model IntakeAnswer {
  id         String @id @default(cuid())
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  questionId String // question ids defined in navigator content
  valueJson  String // serialized AnswerValue

  @@unique([caseId, questionId])
}

model ActionPlan {
  id                        String   @id @default(cuid())
  case                      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId                    String   @unique
  generatedAt               DateTime @default(now())
  situationSummary          String
  priority                  String // Priority values
  nextActionsJson           String // serialized {title, detail}[]
  riskFlagsJson             String // serialized RiskFlag[]
  suggestedLetterTemplateId String?
  disclaimer                String
}

model Task {
  id          String    @id @default(cuid())
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  title       String
  description String?
  category    String?
  done        Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([caseId])
}

model DocumentRequirement {
  id          String  @id @default(cuid())
  case        Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  name        String
  description String?
  required    Boolean @default(false)
  status      String  @default("needed") // DocumentStatus values

  @@index([caseId])
}

model Deadline {
  id       String   @id @default(cuid())
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId   String
  title    String
  date     DateTime
  note     String?
  verified Boolean  @default(false)

  @@index([caseId])
}

model GeneratedLetter {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  templateId String
  title      String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([caseId])
}

model TimelineEvent {
  id     String   @id @default(cuid())
  case   Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String
  type   String // TimelineEventType values
  title  String
  detail String?
  date   DateTime @default(now())

  @@index([caseId])
}

model UploadedFile {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  fileType   String
  sizeLabel  String // human-readable; bytes stay on the user's device in Phase 1
  category   String // FileCategory values
  storageKey String   @default("") // reserved for S3/Supabase Storage object keys
  status     String   @default("pending_review") // FileStatus values
  notes      String   @default("")
  uploadedAt DateTime @default(now())

  @@index([caseId])
}

model Subscription {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String    @unique
  tier             String    @default("self_service") // ServiceTierId values
  status           String    @default("active") // "active" | "canceled"
  stripeCustomerId String?
  stripeSubId      String?
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         Payment[]
}

// Simulated billing history entries (Stripe-shaped; no real charges).
model Payment {
  id              String       @id @default(cuid())
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId  String
  stripePaymentId String?
  label           String
  amountLabel     String
  kind            String // "mock_charge" | "mock_refund" | "plan_change"
  createdAt       DateTime     @default(now())
}

// Polymorphic staff note: exactly one of caseId / ticketId / reviewId is set.
// Case + ticket notes are staff-only; review notes are customer-visible.
model AdminNote {
  id         String         @id @default(cuid())
  case       Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String?
  ticket     SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String?
  review     ReviewRequest? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   String?
  authorName String
  body       String
  createdAt  DateTime       @default(now())
}

model SupportTicket {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  case          Case?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  caseId        String?
  category      String // TicketCategory values
  subject       String
  status        String          @default("open") // TicketStatus values
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      TicketMessage[]
  internalNotes AdminNote[]

  @@index([userId])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  authorRole String // "customer" | "staff"
  authorName String
  body       String
  createdAt  DateTime      @default(now())
}

model ReviewRequest {
  id            String      @id @default(cuid())
  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  status        String      @default("requested") // ReviewStatus values
  customerNotes String
  requestedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  reviewerNotes AdminNote[]

  @@index([userId])
}

model DisclaimerAcceptance {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  caseId             String?
  version            String
  acceptedTerms      Boolean
  acceptedPrivacy    Boolean
  acceptedDisclaimer Boolean
  acceptedAt         DateTime @default(now())

  @@index([userId, version])
}

// Append-only record of staff actions (status changes, assignments, notes,
// review decisions, file verification, resets). Written server-side only;
// exposed read-only to admin sessions. Never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorName  String
  actorRole  String // "customer" | "admin" — staff actions are the priority
  action     String // e.g. "case.set_status", "review.set_status", "file.verify"
  targetType String // "case" | "ticket" | "review" | "file" | "system"
  targetId   String
  caseId     String? // denormalized for per-case audit trails
  detail     String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([caseId])
}

model NotificationEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // NotificationEventType values
  channel   String // "email" | "sms"
  subject   String
  body      String
  status    String   @default("mock_sent") // queued | mock_sent (no real delivery in Phase 1)
  createdAt DateTime @default(now())

  @@index([userId])
}
