# ============================================================================
# BureauOS environment variables
# ============================================================================
# Local development:   cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Only DATABASE_URL and AUTH_SECRET are needed to run locally. Every optional
# integration below FAILS CLOSED when unset: the feature is shown as
# unavailable and nothing is faked. Never commit a real .env.
# ============================================================================

# --- Database (REQUIRED) ----------------------------------------------------
# The engine is chosen from the URL (scripts/prisma-env.mjs):
#   file:...        → SQLite, prisma/schema.prisma            (development)
#   postgresql://.. → PostgreSQL, prisma/postgres/schema.prisma (production)
# OneDrive/Dropbox can lock SQLite files; if so, point outside the synced folder,
# e.g. DATABASE_URL="file:C:/dev/bureauos/dev.db"
DATABASE_URL="file:./dev.db"
# Production: a managed Postgres with TLS, encryption at rest, and point-in-time recovery.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bureauos?sslmode=require"

# --- Auth (REQUIRED) ----------------------------------------------------------
# Signs and encrypts session cookies. Generate: openssl rand -hex 32  (or: npx auth secret)
AUTH_SECRET="replace-me-with-a-random-64-hex-string"
# Public URL of the deployment. Pins the CSRF origin check, Stripe return URLs,
# and links in emails. Set it in every deployed environment.
# BUREAUOS_APP_URL="https://app.example.com"
# AUTH_URL="https://app.example.com"            # Auth.js; usually the same value
# Proxies in front of the app that append to X-Forwarded-For (default 1, e.g.
# Vercel or one load balancer). 0 = exposed directly; the header is then ignored.
# BUREAUOS_TRUSTED_PROXY_HOPS="1"
# Staff (admin) accounts must use TOTP two-factor sign-in in production.
# Leave unset. "false" disables the requirement (not recommended); in
# development "true" turns it on.
# BUREAUOS_REQUIRE_STAFF_MFA=""

# --- Rate limiting (recommended for any multi-instance/serverless deploy) -----
# Without these, limits are per process and not shared between instances.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Payments: Stripe (the Case Pass) ------------------------------------------
# BOTH are required; with either missing, checkout and the webhook return 503.
# A test-mode key (sk_test_/rk_test_) is refused in production unless
# BUREAUOS_STRIPE_ALLOW_TEST_MODE="true" (staging only — the UI then shows a
# test-mode banner and purchases are recorded as livemode=false).
# Webhook endpoint: https://<your domain>/api/stripe/webhook — see
# docs/production_readiness.md for the events to subscribe to.
# STRIPE_SECRET_KEY=""                 # restricted key with Checkout Sessions write is enough
# STRIPE_WEBHOOK_SECRET=""             # whsec_… from the webhook endpoint
# BUREAUOS_STRIPE_ALLOW_TEST_MODE=""
# Case Pass price in cents (100–100000). Default 2900 ($29).
# BUREAUOS_CASE_PASS_PRICE_CENTS="2900"

# --- Email: Resend ---------------------------------------------------------------
# Both required to send. Without them: development records email to a local
# outbox (and the server log); production sends nothing and the UI says so —
# including that deadline reminders and password reset are unavailable.
# RESEND_API_KEY=""
# EMAIL_FROM="BureauOS <notify@yourdomain.com>"   # a sender on a domain verified in Resend

# --- Scheduled runner ----------------------------------------------------------
# Protects /api/internal/notifications (deadline reminders + email retries).
# Call it every 15 minutes with: Authorization: Bearer $CRON_SECRET
# At least 16 characters; without it the runner is switched off (503).
# CRON_SECRET=""

# --- Human-assisted services (OFF) -----------------------------------------------
# Professional review and the human-assisted tiers are not offered. Turning
# this on is an operations decision that needs qualified staff and a defined
# scope — not a demo switch.
# BUREAUOS_HUMAN_REVIEW_ENABLED=""

# --- Retention (npm run retention; defaults shown, minimums enforced) ---------------
# BUREAUOS_RETAIN_NOTIFICATIONS_DAYS="180"
# BUREAUOS_RETAIN_ABANDONED_CHECKOUT_DAYS="30"
# BUREAUOS_RETAIN_STRIPE_EVENT_DAYS="90"
