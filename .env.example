# ============================================================================
# BureauOS environment variables
# ============================================================================
# Copy this file to .env before running the app:   cp .env.example .env
# (Windows: Copy-Item .env.example .env)
#
# DATABASE_URL is the only REQUIRED variable. Everything else is a documented
# UPGRADE PATH — setting those does nothing until the matching integration is
# wired in (see README → Production upgrade path). Never commit a real .env.
# ============================================================================

# --- Database (REQUIRED — Prisma; schema in prisma/schema.prisma)
# Local development default (SQLite file lives at prisma/dev.db):
DATABASE_URL="file:./dev.db"
# If OneDrive/Dropbox file locking causes trouble, point at a path outside the
# synced folder, e.g.:  DATABASE_URL="file:C:/dev/bureauos/dev.db"
# Production: switch prisma/schema.prisma provider to "postgresql" and use:
# DATABASE_URL="postgresql://user:pass@host:5432/bureauos"

# --- Auth (REQUIRED — Auth.js session JWT signing/encryption key)
# Generate one:  openssl rand -hex 32   (or npx auth secret)
AUTH_SECRET="replace-me-with-a-random-64-hex-string"

# --- Demo reset endpoint guard (optional)
# /api/dev/reset refuses in production builds unless this is explicitly set.
# BUREAUOS_ALLOW_RESET="true"

# --- Hosted identity (optional future swap; Auth.js credentials is active)
# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Supabase Auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never exposed to the client

# --- Payments (Stripe; replaces the simulated checkout in /checkout)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=            # verify webhook signatures — required

# --- File storage (choose one; replaces metadata-only uploads)
# S3 / R2 / GCS
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=                 # for R2 / S3-compatible endpoints

# --- Notifications (replaces the mock outbox)
# RESEND_API_KEY=                   # or SENDGRID_API_KEY / POSTMARK_API_TOKEN
# EMAIL_FROM="BureauOS <notify@yourdomain.com>"
# TWILIO_ACCOUNT_SID=               # or AWS SNS/SES credentials
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- AI assistant (replaces the rule-based provider in lib/assistant.ts)
# ANTHROPIC_API_KEY=                # or OPENAI_API_KEY / OPENROUTER_API_KEY
