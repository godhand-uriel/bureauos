# ============================================================================
# BureauOS environment variables
# ============================================================================
# The local MVP requires NO environment variables — it runs fully offline with
# demo auth, mock billing, mock notifications, and localStorage persistence.
#
# Every variable below is a documented UPGRADE PATH. Setting them does nothing
# until the matching integration is wired in (see README → Production upgrade
# path). Never commit a real .env file.
# ============================================================================

# --- Database (Prisma → Postgres/Supabase/Neon/RDS; schema in prisma/schema.prisma)
# DATABASE_URL="postgresql://user:pass@host:5432/bureauos"

# --- Authentication (choose one provider; replaces lib/store.ts demo auth)
# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Supabase Auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never exposed to the client
# Auth.js
# AUTH_SECRET=

# --- Payments (Stripe; replaces the simulated checkout in /checkout)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=            # verify webhook signatures — required

# --- File storage (choose one; replaces metadata-only uploads)
# S3 / R2 / GCS
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=                 # for R2 / S3-compatible endpoints

# --- Notifications (replaces the mock outbox)
# RESEND_API_KEY=                   # or SENDGRID_API_KEY / POSTMARK_API_TOKEN
# EMAIL_FROM="BureauOS <notify@yourdomain.com>"
# TWILIO_ACCOUNT_SID=               # or AWS SNS/SES credentials
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- AI assistant (replaces the rule-based provider in lib/assistant.ts)
# ANTHROPIC_API_KEY=                # or OPENAI_API_KEY / OPENROUTER_API_KEY
